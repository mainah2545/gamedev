<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gamedev">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ImageListActivity"
            android:exported="false"
            android:label="@string/title_image_list" />
        <activity
            android:name=".ImageDetailActivity"
            android:exported="false"
            android:label="@string/title_image_detail" />
        <activity
            android:name=".TextListActivity"
            android:exported="false"
            android:label="@string/title_text_list" />
        <activity
            android:name=".TextDetailActivity"
            android:exported="false"
            android:label="@string/title_text_detail" />
        <activity
            android:name=".SummaryActivity"
            android:exported="false"
            android:label="@string/title_summary" />
    </application>

</manifest>
